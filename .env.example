# Copy to .env and fill in. Only one credential is needed.
# The flagger and verifier both use this single key.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional model overrides (defaults shown).
FLAGGER_MODEL=gemini-2.5-flash
VERIFIER_MODEL=gemini-flash-lite-latest
TRANSCRIBE_MODEL=gemini-flash-latest
